<resources>

    <!-- Max network scan search time in seconds -->
    <integer name="config_network_scan_helper_max_search_time_sec">254</integer>

    <!-- Whether to show or hide sensitive info (like IMEI and Phone Number) on About phone -->
    <bool name="configShowDeviceSensitiveInfo">true</bool>

    <!-- Whether to show min / max refresh rate preference in display settings -->
    <bool name="config_show_refresh_rate_switch">true</bool>

    <!-- Whether to show min refresh rate in display settings -->
    <bool name="config_show_min_refresh_rate_switch">true</bool>

    <!-- Whether to show min/max refresh rate in display settings -->
    <bool name="config_show_refresh_rate_controls">true</bool>

    <!-- Does the device supports Smart Battery -->
    <bool name="config_smart_battery_available">true</bool>

    <!-- Whether to show the Preference for Adaptive connectivity -->
    <bool name="config_show_adaptive_connectivity">false</bool>

</resources>
